<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: {{statusColor status}}; color: white; padding: 20px; border-radius: 8px 8px 0 0; }
    .content { background: #f9fafb; padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }
    .section { background: white; padding: 15px; margin-bottom: 15px; border-radius: 6px; border: 1px solid #e5e7eb; }
    .label { font-weight: 600; color: #6b7280; font-size: 14px; }
    .value { color: #111827; font-size: 16px; margin-top: 4px; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 14px; font-weight: 500; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-error { background: #fee2e2; color: #991b1b; }
    .error-box { background: #fef2f2; border: 1px solid #fecaca; padding: 12px; border-radius: 6px; color: #991b1b; margin-top: 10px; }
    .warning-box { background: #fffbeb; border: 1px solid #fde68a; padding: 12px; border-radius: 6px; color: #92400e; margin-top: 10px; }
    .footer { text-align: center; margin-top: 20px; color: #6b7280; font-size: 14px; }
  </style>
</head>
<body>
  <div class="header">
    <h1 style="margin: 0; font-size: 24px;">Job {{#if (isWarning status)}}Completed with Warnings{{else if (isSuccess status)}}Completed{{else}}Failed{{/if}}</h1>
    <p style="margin: 8px 0 0 0; opacity: 0.9;">{{jobName}}</p>
  </div>
  
  <div class="content">
    <div class="section">
      <div class="label">Status</div>
      <div class="value">
        <span class="badge {{#if (isWarning status)}}badge-warning{{else if (isSuccess status)}}badge-success{{else}}badge-error{{/if}}">
          {{#if (isWarning status)}}Completed with warnings{{else}}{{status}}{{/if}}
        </span>
      </div>
    </div>

    <div class="section">
      <div class="label">Job Details</div>
      <div class="value">
        <strong>Job ID:</strong> {{jobId}}<br>
        <strong>Project:</strong> {{projectName}}<br>
        <strong>Execution Time:</strong> {{formatDate executionTime}}
      </div>
    </div>

    <div class="section">
      <div class="label">Execution Metrics</div>
      <div class="value">
        <strong>Duration:</strong> {{formatDuration duration}}<br>
        <strong>Records Processed:</strong> {{formatNumber recordsProcessed}}
        {{#if hasViolations}}
          <br><strong>Quality Violations:</strong> <span style="color: #d97706;">{{formatNumber qualityViolations}}</span>
        {{/if}}
      </div>
    </div>

    {{#if (isWarning status)}}
    <div class="section">
      <div class="label">Quality Warnings</div>
      <div class="warning-box">
        This job completed successfully but encountered {{formatNumber qualityViolations}} quality violation(s). Please review the Quality Violations tab for details.
      </div>
    </div>
    {{/if}}

    {{#if error}}
    <div class="section">
      <div class="label">Error Details</div>
      <div class="error-box">
        {{error}}
      </div>
    </div>
    {{/if}}

    {{#if hasViolations}}
    {{#unless (isWarning status)}}
    <div class="section">
      <div class="label">Quality Violations</div>
      <div class="value">
        <p style="margin: 0;">This job encountered {{formatNumber qualityViolations}} quality violations. Please review the attached report for details.</p>
      </div>
    </div>
    {{/unless}}
    {{/if}}
  </div>

  <div class="footer">
    <p>This is an automated alert from Data File Observatory</p>
  </div>
</body>
</html>
