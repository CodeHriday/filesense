<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #2563eb; color: white; padding: 20px; border-radius: 8px 8px 0 0; }
    .content { background: #f9fafb; padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }
    .section { background: white; padding: 15px; margin-bottom: 15px; border-radius: 6px; border: 1px solid #e5e7eb; }
    .label { font-weight: 600; color: #6b7280; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px; }
    .value { color: #111827; font-size: 16px; margin-top: 4px; }
    .badge { display: inline-block; padding: 4px 12px; border-radius: 12px; font-size: 14px; font-weight: 500; }
    .badge-draft { background: #e5e7eb; color: #374151; }
    .badge-active { background: #dbeafe; color: #1e40af; }
    .badge-pending { background: #fef3c7; color: #92400e; }
    .badge-approved { background: #d1fae5; color: #065f46; }
    .change-list { margin: 0; padding: 0; list-style: none; }
    .change-item { padding: 8px 12px; margin-bottom: 8px; background: #fffbeb; border-left: 3px solid #f59e0b; border-radius: 0 4px 4px 0; font-size: 14px; }
    .change-field { font-weight: 600; color: #374151; }
    .change-old { color: #991b1b; text-decoration: line-through; }
    .change-new { color: #065f46; font-weight: 500; }
    .change-arrow { color: #6b7280; margin: 0 8px; }
    .cta-button { display: inline-block; background: #2563eb; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 500; margin-top: 15px; }
    .cta-button:hover { background: #1d4ed8; }
    .footer { text-align: center; margin-top: 20px; color: #6b7280; font-size: 14px; }
    .meta-row { display: flex; justify-content: space-between; margin-bottom: 8px; }
    .meta-label { color: #6b7280; font-size: 14px; }
    .meta-value { color: #111827; font-size: 14px; font-weight: 500; }
  </style>
</head>
<body>
  <div class="header">
    <h1 style="margin: 0; font-size: 24px;">Vendor Agreement Updated</h1>
    <p style="margin: 8px 0 0 0; opacity: 0.9;">{{agreementCode}}</p>
  </div>
  
  <div class="content">
    <div class="section">
      <div class="label">Agreement Details</div>
      <div class="value" style="margin-top: 12px;">
        <div class="meta-row">
          <span class="meta-label">Vendor:</span>
          <span class="meta-value">{{vendorName}}</span>
        </div>
        <div class="meta-row">
          <span class="meta-label">Agreement Code:</span>
          <span class="meta-value">{{agreementCode}}</span>
        </div>
        <div class="meta-row">
          <span class="meta-label">Status:</span>
          <span class="meta-value">
            <span class="badge badge-{{statusClass}}">{{status}}</span>
          </span>
        </div>
        {{#if approvalStatus}}
        <div class="meta-row">
          <span class="meta-label">Approval Status:</span>
          <span class="meta-value">{{approvalStatus}}</span>
        </div>
        {{/if}}
        <div class="meta-row">
          <span class="meta-label">Updated By:</span>
          <span class="meta-value">{{updatedByName}}</span>
        </div>
        <div class="meta-row">
          <span class="meta-label">Updated At:</span>
          <span class="meta-value">{{formatDate updatedAt}}</span>
        </div>
      </div>
    </div>

    {{#if hasChanges}}
    <div class="section">
      <div class="label">What Changed</div>
      <ul class="change-list" style="margin-top: 12px;">
        {{#each changes}}
        <li class="change-item">
          <span class="change-field">{{field}}:</span>
          {{#if oldValue}}
          <span class="change-old">{{oldValue}}</span>
          <span class="change-arrow">→</span>
          {{/if}}
          <span class="change-new">{{newValue}}</span>
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if changeSummary}}
    <div class="section">
      <div class="label">Change Summary</div>
      <div class="value" style="margin-top: 8px; white-space: pre-line;">{{changeSummary}}</div>
    </div>
    {{/if}}

    <div class="section" style="text-align: center;">
      <div class="label">View Agreement</div>
      <a href="{{agreementUrl}}" class="cta-button">Open Agreement Details</a>
    </div>
  </div>

  <div class="footer">
    <p>This is an automated notification from Data File Observatory</p>
    <p style="font-size: 12px; color: #9ca3af;">You are receiving this email because you are listed as a stakeholder for this vendor agreement.</p>
  </div>
</body>
</html>
