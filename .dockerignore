# ===========================================
# DOCKER IGNORE FOR DEPLOYMENT SIZE REDUCTION
# ===========================================

# Large cache directories (saves ~2.4 GB)
.cache/
.local/
.upm/
.config/

# Python environment (saves ~600 MB)
.pythonlibs/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# Node modules excluded - fresh install in container
node_modules/

# Git history (can be large)
.git/
.gitignore
.gitattributes

# Development and IDE files
.vscode/
.idea/
*.swp
*.swo
.env.local
.env.development
.env.test

# Build cache
.vite/
.parcel-cache/
.turbo/
.next/

# Test files
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__/
tests/
coverage/
.nyc_output/

# Documentation (except README)
*.md
!README.md
docs/
CHANGELOG*
LICENSE*

# Temporary and data files
temp/
tmp/
*.tmp
uploads/
*.csv
*.xlsx
*.json.backup
*.sql
*.db

# Debug and development assets
attached_assets/
rust-log-service/

# Source maps (large, not needed in prod)
*.map

# TypeScript source (compiled JS used)
*.ts
!*.d.ts
tsconfig*.json

# Package manager files
yarn.lock
pnpm-lock.yaml
.npmrc
.yarnrc

# Linting and formatting configs
.eslintrc*
.prettierrc*
eslint.config.*
.editorconfig

# Replit specific
.replit
replit.nix
.replit.local
*.local

# Miscellaneous
.DS_Store
Thumbs.db
*.bak
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large binary files
*.so
*.dll
*.dylib
*.wasm
