# ===========================================
# DOCKER IGNORE FOR DEPLOYMENT SIZE REDUCTION
# Target: Reduce from 8+ GiB to under limit
# ===========================================

# ============================================
# LARGE CACHE DIRECTORIES (saves ~2.4 GB)
# ============================================
.cache/
.local/
.upm/
.config/
.npm/
.yarn/

# ============================================
# PYTHON ENVIRONMENT (saves ~600 MB)
# ============================================
.pythonlibs/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.whl

# ============================================
# NODE MODULES - Fresh install in container
# ============================================
node_modules/

# ============================================
# CLAMAV DATABASE (saves ~300 MB)
# ============================================
clamav-db/
freshclam.conf

# ============================================
# ARCHIVED/UNUSED SERVICES (saves ~500+ MB)
# ============================================
archived_streamlit/
data-file-observatory/
rust-log-service/
server/

# ============================================
# DATA AND UPLOAD DIRECTORIES
# ============================================
uploads/
data/
logs/
dbt_project/

# ============================================
# GIT HISTORY
# ============================================
.git/
.gitignore
.gitattributes

# ============================================
# DEVELOPMENT/IDE FILES
# ============================================
.vscode/
.idea/
*.swp
*.swo
.env.local
.env.development
.env.test

# ============================================
# BUILD CACHE
# ============================================
.vite/
.parcel-cache/
.turbo/
.next/
dist/

# ============================================
# TEST FILES
# ============================================
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__/
tests/
backend/tests/
coverage/
.nyc_output/

# ============================================
# DOCUMENTATION
# ============================================
*.md
docs/
CHANGELOG*
LICENSE*

# ============================================
# DATABASE FILES AND BACKUPS
# ============================================
*.sql
*.db
*.sqlite
*.sqlite3
database_backup.sql
database_schema_dump.sql
development_schema_dump.sql
production_schema_sync.sql

# ============================================
# TEMPORARY FILES
# ============================================
temp/
tmp/
*.tmp
*.csv
*.xlsx
*.json.backup

# ============================================
# ATTACHED/DEBUG ASSETS
# ============================================
attached_assets/

# ============================================
# SOURCE MAPS (large, not needed in prod)
# ============================================
*.map

# ============================================
# DEVELOPMENT SCRIPTS
# ============================================
scripts/
migrations/
backfill_metrics.js
reprofile_files.js
test_*.js
initBusinessProcessTables.js

# ============================================
# BACKUP FILES
# ============================================
*.bak
*.backup
*.old
server.js.backup
server.js.bak
server.js.old
server_fixed.js
server_new.js
server_without_processes.js

# ============================================
# PACKAGE MANAGER FILES
# ============================================
yarn.lock
pnpm-lock.yaml
.npmrc
.yarnrc
uv.lock
pyproject.toml
requirements

# ============================================
# LINTING AND FORMATTING CONFIGS
# ============================================
.eslintrc*
.prettierrc*
eslint.config.*
.editorconfig
tsconfig*.json

# ============================================
# REPLIT SPECIFIC
# ============================================
.replit
replit.nix
replit.md
.replit.local
*.local

# ============================================
# MISCELLANEOUS
# ============================================
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# LARGE BINARY FILES
# ============================================
*.so
*.dll
*.dylib
*.wasm
*.node
