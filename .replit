modules = ["python-3.11", "nodejs-20", "python3", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["arrow-cpp", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "pkg-config", "readstat", "tcl", "tk", "yajl", "zlib"]

[deployment]
deploymentTarget = "gce"
run = ["sh", "-c", "NODE_ENV=production npm run start"]
build = ["sh", "-c", "npm run build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "react-dev-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "profile-api-server"

[[workflows.workflow]]
name = "react-dev-server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vite --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "api-server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development node server.js"

[[workflows.workflow]]
name = "profile-api-server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DISABLE_VIRUS_SCAN=true python profile_api.py"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8099

[[ports]]
localPort = 33527
externalPort = 8000

[[ports]]
localPort = 33737
externalPort = 3003

[[ports]]
localPort = 35637
externalPort = 5000

[[ports]]
localPort = 35757
externalPort = 6800

[[ports]]
localPort = 36477
externalPort = 4200

[[ports]]
localPort = 38089
externalPort = 8008

[[ports]]
localPort = 38297
externalPort = 8081

[[ports]]
localPort = 39645
externalPort = 5173

[[ports]]
localPort = 40411
externalPort = 3002

[[ports]]
localPort = 40819
externalPort = 9000

[[ports]]
localPort = 43103
externalPort = 8080

[[ports]]
localPort = 45955
externalPort = 6000

[[ports]]
localPort = 46193
externalPort = 3001

[agent]
integrations = ["python_openai_ai_integrations:1.0.0"]

[userenv]

[userenv.shared]
ALLOWED_ORIGINS = "http://localhost:5000,http://localhost:3000,https://*.replit.dev,https://*.replit.app,http://filesense-qa.blumetra.com,https://filesense-qa.blumetra.com,http://filesense.blumetra.com,https://filesense.blumetra.com"
