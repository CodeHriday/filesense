# ============================================
# SECURITY WARNING: PRODUCTION CONFIGURATION
# ============================================
# This file contains example configuration values.
# NEVER use these values in production!
# NEVER commit actual secrets to version control!
# Use strong, unique values for all secrets.
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# SECURITY: Use strong passwords (minimum 16 characters, mixed case, numbers, symbols)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_use_strong_password_min_16_chars
DB_NAME=your_db_name
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/your_db_name

# JWT Configuration
# SECURITY CRITICAL: Use a cryptographically secure random string for JWT_SECRET
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use default values in production - application should fail if not set
JWT_SECRET=REQUIRED_generate_with_crypto_randomBytes_64_min
JWT_EXPIRATION=7200 # 2 hours (reduced from 24h for better security)
JWT_REFRESH_EXPIRATION=86400 # 24 hours

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600 # 100MB (reduced from 1GB for security)

# CORS Configuration
# SECURITY: Restrict to specific domains in production, never use '*'
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Security - Rate Limiting
# Protects against brute force and DoS attacks
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Security - Session Configuration
# For httpOnly cookies (recommended over localStorage)
SESSION_SECRET=REQUIRED_generate_with_crypto_randomBytes_32_min
SESSION_MAX_AGE=7200000 # 2 hours in milliseconds

# ============================================
# PRODUCTION CHECKLIST:
# ============================================
# [ ] Change ALL default passwords and secrets
# [ ] Use environment-specific values (dev/staging/prod)
# [ ] Enable HTTPS/TLS in production
# [ ] Set NODE_ENV=production
# [ ] Configure proper CORS origins
# [ ] Enable security headers (helmet)
# [ ] Set up rate limiting
# [ ] Configure proper logging
# [ ] Regular security audits with npm audit
# ============================================