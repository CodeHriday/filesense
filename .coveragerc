[run]
source = .
branch = True
omit =
    */tests/*
    */__pycache__/*
    */node_modules/*
    */venv/*
    */.pythonlibs/*
    */migrations/*
    setup.py
    conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

show_missing = True
precision = 2
fail_under = 0

[html]
directory = coverage/python/htmlcov

[xml]
output = coverage/python/coverage.xml
